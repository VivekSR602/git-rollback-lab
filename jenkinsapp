    }
    stages{
        stage('checkout'){
            steps{
                git branch: 'main', credentialsId: 'git_creds_siddesh', url: 'https://github.com/Siddeshg672/cicd-microservices.git'
            }
        }
        stage('Sonar Scan') {
            steps {
                script {
                    def scannerHome = tool 'sonar_server';
                    withSonarQubeEnv('sonar_server') {
                        sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=${ms} -Dsonar.projectName=${ms} -Dsonar.sources=."
                    }
                }
            }
        }
        stage('create docker image'){
            steps{
                dir("services/${ms}") {
                    sh "docker build -t hiqodeinnovations.jfrog.io/dockerimageappa/cicd-app/${ms}:v.1.0.${BUILD_NUMBER} ."
                }
            }
        }
        stage('push docker image to Jfrog'){
            steps{
                withCredentials([usernamePassword(credentialsId: 'jforg_login_docker', passwordVariable: 'pass', usernameVariable: 'user')]) {
                    sh "docker login -u ${user} -p ${pass} hiqodeinnovations.jfrog.io"
                    sh "docker push hiqodeinnovations.jfrog.io/dockerimageappa/cicd-app/${ms}:v.1.0.${BUILD_NUMBER}"
                    sh "docker rmi -f hiqodeinnovations.jfrog.io/dockerimageappa/cicd-app/${ms}:v.1.0.${BUILD_NUMBER}"
                }
            }
        }
        stage('deploy the docker container'){
            steps{
                script{
                    sh """
                        chmod 400 terraform_ohio.pem
                        export ANSIBLE_HOST_KEY_CHECKING=False
                        ansible-playbook ansible-deploy.yml -i hosts.ini --private-key terraform_ohio.pem -u ubuntu -e "BUILD_NUMBER=${BUILD_NUMBER}" -e "microservice=${ms}" -e "port_host=${port_host}" -e "port_cont=${port_cont}"
                    """
                }
            }
        }
    }
}
