Parameters

pipeline {
    agent any
    environment {
        tool_name = 'docker'
    }
    parameters{ 
        string ( name: 'DEPLOY_ENV', defaultValue: 'staging', description: '' ) 
        booleanParam(name: 'DEBUG_BUILD', defaultValue: true, description: '')
        choice(name: 'CHOICES', choices: ['one', 'two', 'three'], description: '')
        string ( name: 'ENV' )
    }
    stages {
        stage('Hello') {
            when { expression { DEBUG_BUILD == 'true' } }
            steps {
                sh 'echo ${BUILD_NUMBER}'
                sh 'echo ${tool_name}'
                sh "echo ${user}"
                print DEPLOY_ENV
                print DEBUG_BUILD
            }
        }
        stage('test'){
            when { expression { DEBUG_BUILD == 'false' } }
            steps{
                sh 'echo ${BUILD_NUMBER}'
            }
        }
    }
}
